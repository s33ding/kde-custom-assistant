# --- Sidekick (assistant) ---
PORT=58829

# AI routing: when SMOOTH_API_URL is set, chat/improve/ocr go through the
# SmoothDialogue (Flask) service, which uses AWS Bedrock.
SMOOTH_API_URL=http://smooth:5000/

# System prompt for the chat assistant
SYSTEM_PROMPT=Você é um assistente prestativo e amigável. Responda de forma clara e concisa.

# Txt Extract: directory to auto-load the latest screenshot from
SCREENSHOTS_DIR=/screenshots

# --- AWS Bedrock (SmoothDialogue) ---
# Generated by ./scripts/aws-env.sh from the host's AWS profile (default: iesb).
# These are injected into the `smooth` container. DO NOT COMMIT real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
FLASK_SECRET_KEY=change-me

# --- Optional: OpenAI fallback (only if SMOOTH_API_URL is unset) ---
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
