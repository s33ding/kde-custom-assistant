# Random high port chosen to avoid clashing with common services
PORT=58829

# AI provider configuration
# Supported providers: openai | bedrock | mock
AI_PROVIDER=mock

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# System prompt for the assistant
SYSTEM_PROMPT=You are a helpful assistant embedded in a web page.
