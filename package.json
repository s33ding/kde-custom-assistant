{
  "name": "sidekick-ai",
  "version": "0.1.0",
  "description": "Sidekick — an embeddable AI assistant that opens as a chat widget in any web page.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:docker": "nodemon --legacy-watch --watch server --ext js,json server/index.js"
  },
  "keywords": [
    "ai",
    "assistant",
    "widget",
    "chatbot",
    "embeddable"
  ],
  "author": "s33ding",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2"
  },
  "devDependencies": {
    "nodemon": "3.1.9"
  }
}
